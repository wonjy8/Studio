# Studio environment template
#
# Never place real secrets in this file.
# Copy to a local .env file when development configuration is needed.

# Example non-secret configuration:
# APP_ENV=development

# AI provider authentication is intentionally not defined here yet.
# Studio's AI integration will be user-configured and must follow the
# provider's current secure authentication guidance before implementation.

# Google Sheets OAuth (Web application). Set securely on the deployment host.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI: https://studio.wonjongyou.com/oauth/google/callback
