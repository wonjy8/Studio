# Only the inputs explicitly copied by Dockerfile enter the build context.
**
!Dockerfile
!package.json
!index.html
!src/
!src/**
!server/
!server/**
!tools/
!tools/**

# Runtime data and local secrets are excluded even inside source directories.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*.log
**/.DS_Store
**/data
**/uploads
**/storage
**/local-db
**/backups
**/reports
**/logs
**/debug
**/node_modules
